# Local environment variables — DO NOT commit this file to version control
# Replace the placeholder values with your actual Twilio and Firebase settings

# Twilio (used by Firebase Functions or server-side code)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# If your Firebase Functions expect these names, keep them as-is.

# Vite frontend (prefix VITE_ to expose to client-side code)
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_API_KEY=
VITE_TWILIO_API_SECRET=

# Firebase Functions region (optional)
FIREBASE_FUNCTIONS_REGION=us-central1
